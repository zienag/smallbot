{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smallbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Real browser for openai.com article pages; quickAction needs no client
  // library, only a compatibility date of 2026-03-24 or later.
  "browser": { "binding": "BROWSER" },
  // One cron per company's sources plus the fast one for the status watch;
  // src/crons.ts dispatches on the literal strings (ANTHROPIC_CRON,
  // OPENAI_CRON, STATUS_CRON), so the two files must agree exactly.
  "triggers": {
    "crons": ["*/15 * * * *", "5,20,35,50 * * * *", "*/5 * * * *"]
  },
  "kv_namespaces": [
    { "binding": "RELEASES", "id": "2254c70148884faa8d27f6fd73e08e81" }
  ],
  "d1_databases": [
    {
      "binding": "ARCHIVE",
      "database_name": "smallbot-archive",
      "database_id": "cc717820-d21b-4e7a-8214-8dd0e5779566"
    }
  ],
  "vars": {
    "TELEGRAM_CHAT_ID": "@claudecode_changelog",
    "TELEGRAM_CODEX_CHAT_ID": "@codex_changelog",
    "TELEGRAM_MODELS_CHAT_ID": "@model_drops",
    "TELEGRAM_ANTHROPIC_BLOG_CHAT_ID": "@anthropic_blogs",
    "TELEGRAM_OPENAI_BLOG_CHAT_ID": "@openai_blogs",
    "TELEGRAM_STATUS_CHAT_ID": "@anthropic_status",
    "TELEGRAM_STATUS_BOT_USERNAME": "anthropic_status_watch_bot",
    "DRY_RUN": "0"
  }
}
